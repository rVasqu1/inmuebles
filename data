        if (oTemplate) {
            var oBindingInfo = oTemplate.getBindingInfo("value") || oTemplate.getBindingInfo("text");
            if (oBindingInfo && oBindingInfo.parts && oBindingInfo.parts.length > 0) {
                sProperty = oBindingInfo.parts[0].path;
            }
        }

        if (!sProperty) return;

        if (sProperty === "ExecutionDate") {
            aColumns.push({ label: sLabel, property: sProperty, type: sap.ui.export.EdmType.Date });
        } else {
            aColumns.push({ label: sLabel, property: sProperty, type: sap.ui.export.EdmType.String });
        }
    });

