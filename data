oFileUploadTipoNat: function (oEvent) {
    //Se lee el fichero
    var oUploader = oEvent.getSource();
    var oFile = oEvent.getParameter("files")[0];
    if (!oFile) return;
    //Funcion base para leer archivo
    var reader = new FileReader();
    reader.onload = function (e) {
        var data = new Uint8Array(e.target.result);
        var workbook = XLSX.read(data, { type: "array" });
        var sheet = workbook.Sheets[workbook.SheetNames[0]];
        var rows = XLSX.utils.sheet_to_json(sheet, { header: 1 }).slice(1);
        //Se crea variable para obtener el modelo 
        var oModel = this.getView().getModel("mapfresa");
        var tipoNat = oModel.getProperty("/tipoNat");
        var aDeleteTNat = oModel.getProperty("/_deleteTipoNat");

        for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            //si la fila esta vacia, se salta
            if (!row || row.length === 0) continue;

            //Se leen los datos de la fila
            var sId = row[0] ? row[0].toString().trim() : "";
            var sOrden = row[1] ? row[1].toString().trim() : "";
            var sDescription = row[2] ? row[2].toString() : "";
            var sDescriptionEng = row[3] ? row[3].toString() : "";
            var item = null;

            if (sId) {
                //La fila ya existe: se busca por Id
                for (var j = 0; j < tipoNat.length; j++) {
                    if ((tipoNat[j].Id + "") === sId) {
                        item = tipoNat[j];
                        break;
                    }
                }
                //Si no esta en la tabla, se mira si se habia borrado y se recupera
                if (!item) {
                    for (var d = 0; d < aDeleteTNat.length; d++) {
                        if ((aDeleteTNat[d].Id + "") === sId) {
                            item = aDeleteTNat[d];
                            //Se saca de borradas y se devuelve a la tabla
                            aDeleteTNat.splice(d, 1);
                            tipoNat.push(item);
                            break;
                        }
                    }
                }
            }

            if (item) {
                //El orden siempre es editable
                item.Orden = sOrden;
                //Las descripciones solo en las tipologias propias (Id que empieza por 9)
                if ((item.Id + "").indexOf("9") === 0) {
                    item.Description = sDescription;
                    item.DescriptionEng = sDescriptionEng;
                }
            } else {
                //Fila nueva: se asigna el Id igual que hace onAddRowTNat
                if (!sOrden && !sDescription) continue;
                item = {
                    Id: this.lastIdTNat + "",
                    Orden: sOrden,
                    Description: sDescription,
                    DescriptionEng: sDescriptionEng
                };
                this.lastIdTNat = this.lastIdTNat + 1;
                // Se agrega el nuevo elemento en el array
                tipoNat.push(item);
            }
        }

        //Se renumera la columna del contador
        for (var n = 0; n < tipoNat.length; n++) {
            tipoNat[n]._numerico = n + 1;
        }

        //Las propriedades se asignan en el modelo
        oModel.setProperty("/tipoNat", tipoNat);
        //Se actualiza el modelo
        oModel.refresh(true);
        //Se limpia el uploader para poder subir el mismo fichero otra vez
        oUploader.clear();
        //Se muestra un mensaje de carga correcta de los datos
        sap.m.MessageToast.show("Excel cargado correctamente");
    }.bind(this);

    reader.readAsArrayBuffer(oFile);
},
