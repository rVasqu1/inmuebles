	xmlns:core="sap.ui.core"
    xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:t="sap.ui.table" 
	xmlns:smartField="sap.ui.comp.smartfield"
	height="100%">
    	<f:DynamicPage id="dynamicPageId" headerExpanded="{/headerExpanded}" height="100%" toggleHeaderOnTitleClick="{/titleClickable}" class="sapUiContentPadding sapUiSizeCompact">
			<!-- DynamicPage Title -->
			<f:title>
				<f:DynamicPageTitle>
					<f:heading>
						<Title text="{i18n>mapfresa}"/>
					</f:heading>
					<f:actions>
						<Button
								text="{i18n>guardar}"
								type="Emphasized"
								press="onGenerarPedido"/>
						<!--<Button
								text="{i18n>Cancelar}"
								type="Transparent"
								press="onCancelar"
								visible="{=${aux>/procesado} ? false : true}"/>			-->			
					</f:actions>
				</f:DynamicPageTitle>
			</f:title>
			<f:content>
	<IconTabBar
		width="100%" height="100%" stretchContentHeight="true" class="sapUiResponsiveContentPadding">
