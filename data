excelDateToJSDate: function (serial) {
    //Si viene vacio o no es numero, se devuelve null
    if (serial === null || serial === undefined || serial === "" || isNaN(serial)) {
        return null;
    }
    var utc_days = Math.floor(serial - 25569);
    var utc_value = utc_days * 86400;
    var date_info = new Date(utc_value * 1000);

    var fecha = new Date(
        date_info.getUTCFullYear(),
        date_info.getUTCMonth(),
        date_info.getUTCDate()
    );
    //Se compensa la zona horaria igual que hace onChangeDate
    return new Date(fecha.getTime() - (fecha.getTimezoneOffset() * 60 * 1000));
},
oFileUploadCeco: function (oEvent) {
    //Se lee el fichero
    var oUploader = oEvent.getSource();
    var oFile = oEvent.getParameter("files")[0];
    if (!oFile) return;
    //Funcion base para leer archivo
    var reader = new FileReader();
    reader.onload = function (e) {
        var data = new Uint8Array(e.target.result);
        var workbook = XLSX.read(data, { type: "array" });
        var sheet = workbook.Sheets[workbook.SheetNames[0]];
        var rows = XLSX.utils.sheet_to_json(sheet, { header: 1 }).slice(1);
        //Se crea variable para obtener el modelo 
        var oModel = this.getView().getModel("mapfresa");
        var ceco = oModel.getProperty("/ceco");
        var tipoCeco = oModel.getProperty("/tipoCeco");

        for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            //si la fila esta vacia, se salta
            if (!row || row.length === 0) continue;

            //Se leen los datos de la fila
            var sCostCenter = row[0] ? row[0].toString().trim() : "";
            var sDedication = row[1] ? row[1].toString().replace("%", "").replace(",", ".").trim() : "";
            var sTypeId = row[2] ? row[2].toString().trim() : "";
            var dDateLow = this.excelDateToJSDate(row[3]);
            var dDateHigh = this.excelDateToJSDate(row[4]);

            //Sin ceco no se puede identificar la fila, se ignora
            if (!sCostCenter) continue;

            //Se busca la fila por clave de negocio, NO por posicion
            var item = null;
            for (var j = 0; j < ceco.length; j++) {
                var iLowMod = ceco[j].DateLow ? new Date(ceco[j].DateLow).getTime() : 0;
                var iHighMod = ceco[j].DateHigh ? new Date(ceco[j].DateHigh).getTime() : 0;
                var iLowExcel = dDateLow ? dDateLow.getTime() : 0;
                var iHighExcel = dDateHigh ? dDateHigh.getTime() : 0;

                if (ceco[j].CostCenter === sCostCenter &&
                    iLowMod === iLowExcel &&
                    iHighMod === iHighExcel) {
                    item = ceco[j];
                    break;
                }
            }

            if (item) {
                //Ya existe: solo se actualiza lo editable, no se toca ceco ni fechas
                item.Dedication = parseFloat(sDedication) || 0;
                item.TypeId = sTypeId;
            } else {
                //Si no existe se crea entrada para el oData
                var oContextCeco = this.getView().getModel().createEntry("/ZCMSD_FACT_CECO", {
                    properties: {
                        Zsociedad: '0004',
                        CostCenter: sCostCenter
                    }
                });
                //se crea objecto local con el path contexto del oData
                item = {
                    _pathSmarfield: oContextCeco.getPath()
                };
                //Se asignan los datos desde Excel
                item.CostCenter = sCostCenter;
                item.Dedication = parseFloat(sDedication) || 0;
                item.TypeId = sTypeId;
                item.DateLow = dDateLow;
                item.DateHigh = dDateHigh;
                // Se agrega el nuevo elemento en el array
                ceco.push(item);
            }

            //Se rellena Type y TypeOrder igual que hace onChangeTipo
            if (item.TypeId) {
                for (var k = 0; k < tipoCeco.length; k++) {
                    if (tipoCeco[k].Id + "" === item.TypeId + "") {
                        item.Type = this.aux.getProperty("/currentL") === 'es-ES'
                            ? tipoCeco[k].Description
                            : tipoCeco[k].DescriptionEng;
                        item.TypeOrder = tipoCeco[k].Orden;
                        break;
                    }
                }
            }
        }

        //Se renumera la columna del contador
        for (var n = 0; n < ceco.length; n++) {
            ceco[n]._numerico = n + 1;
        }

        //Las propriedades se asignan en el modelo
        oModel.setProperty("/ceco", ceco);
        //Se actualiza el modelo
        oModel.refresh(true);
        //Se limpia el uploader para poder subir el mismo fichero otra vez
        oUploader.clear();
        //Se muestra un mensaje de carga correcta de los datos
        sap.m.MessageToast.show("Excel cargado correctamente");
    }.bind(this);

    reader.readAsArrayBuffer(oFile);
},
