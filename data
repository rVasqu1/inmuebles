            comprobarDedicacion: function (cecos, i) {
                var item = cecos[i];
                var sumDedicacion = 0;
                for (var c in cecos) {
                    var ceco = cecos[c];
                    if (item.CostCenter === ceco.CostCenter) {
                        if (item.DateLow <= ceco.DateHigh && item.DateHigh >= ceco.DateLow) {
                            sumDedicacion = sumDedicacion + parseFloat(ceco.Dedication);
                        }
                    }
                }
                return 100 < sumDedicacion
            },
            comprobarCuentas: function (naturalezas, i) {
                var item = naturalezas[i];
                var found = false;
                for (var n in naturalezas) {
                    if (n !== i) {
                        var nat = naturalezas[n];
                        if (item.DateLow <= nat.DateHigh && item.DateHigh >= nat.DateLow) {
                            if (item.SaknrHigh) {
                                if (nat.SaknrHigh) {
                                    if (item.SaknrLow <= nat.SaknrHigh && item.SaknrHigh >= nat.SaknrLow) {
                                        found = true;
                                        break;
                                    }
                                } else {
                                    if (item.SaknrLow >= nat.SaknrLow && item.SaknrHigh <= nat.SaknrLow) {
                                        found = true;
                                        break;
                                    }
                                }
                            } else {
                                if (nat.SaknrHigh) {
                                    if (item.SaknrLow <= nat.SaknrHigh && item.SaknrLow >= nat.SaknrLow) {
                                        found = true;
                                        break;
                                    }
                                } else {
                                    if (item.SaknrLow == nat.SaknrLow) {
                                        found = true;
                                        break;
                                    }
                                }
                            }
                        }
                    }
                }
                return found
            },
            comprobarRangoFecha: function (markups, i) {
                var item = markups[i];
                for (var m in markups) {
                    var markup = markups[m];
                    if (m != i) {
                        if (item.DateLow <= markup.DateHigh && item.DateHigh >= markup.DateLow) {
                            return true;
                        }
                    }
                }
                return false;
            },
