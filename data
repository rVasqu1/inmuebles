							<Button
							press= "onDowloadExcelCeco"
							icon="sap-icon://download"
							/>
							<unified:FileUploader id="UploadCeco" 
							                      buttonOnly="true" 
												  icon="sap-icon://upload" 
												  change="oFileUploadCeco" 
												  buttonText=" " 
												  loadUrl="/dummy" 
												  fileType="xlsx" 
												  sameFilenameAllowed="true" />					
						<!--  FIN RJVS 09/03/2026 botones upload y download -->
						<Button
							icon="sap-icon://add"
							press="onAddRowCeco" visible="{=${aux>/procesado} ? false : true}"/>
                        <Button
							icon="sap-icon://copy"
							press="onCopyRowCeco" visible="{=${aux>/procesado}? false : true}"/>
						<Button
							icon="sap-icon://delete"
							press="onDeleteRowCeco" visible="{=${aux>/procesado}? false : true}"/>
					</OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column
						autoResizable="true"
						width="4rem">
						<Label text="" />
						<t:template>
                            <Text text="{mapfresa>_numerico}"/>
						</t:template>
					</t:Column>
					<t:Column
						autoResizable="true"
						filterProperty = "CostCenter"
						sortProperty = "CostCenter"
						width="6rem">
						<Label text="{i18n>ceco}"  required="true"/>
						<t:template>
                            <smartField:SmartField id="ceco" fieldGroupIds="fg1" editable="{= ${mapfresa>Id} ? false : true}" entitySet="ZCMSD_FACT_CECO"  fixedValueListValidationEnabled="true"  value="{CostCenter}" change="onChangeCeCo"/>
						</t:template>
					</t:Column>
					<t:Column
						autoResizable="true"
						filterProperty = "Dedication"
						sortProperty = "Dedication"
						width="7rem">
						<Label text="{i18n>dedicacion}" required="true" />
						<t:template>
							<Input value="{ path: 'mapfresa>Dedication', formatter: '.formatPorcentaje' }" fieldGroupIds="fgDedicacion"
                                  textAlign="End"  change=".onChangePorcentaje"/>
						</t:template>
					</t:Column>
					<t:Column 
						autoResizable="true"
						filterProperty = "TypeId"
						sortProperty = "TypeId"
						width="15rem">
						<Label text="{i18n>tipologia}" required="true" />
						<t:template>
                            <Select width="100%" forceSelection="false" fieldGroupIds="fgTipologia" enabled="{= ${mapfresa>Id} ? false : true}" selectedKey="{mapfresa>TypeId}" items="{path:'mapfresa>/tipoCeco'}" change="onChangeTipo">
                                <core:Item key="{mapfresa>Id}" text="{= ${mapfresa>Orden} + ': ' + (${aux>/currentL} === 'es-ES' ? ${mapfresa>Description} : ${mapfresa>DescriptionEng}) }"/>
                            </Select>
						</t:template>
					</t:Column>
					<t:Column
						autoResizable="true"
						filterProperty = "DateLow"
						sortProperty = "DateLow"
						width="9rem">
						<Label text="{i18n>desde}"  required="true"/>
						<t:template>
							<DatePicker dateValue="{path:'mapfresa>DateLow'}" 
									displayFormat="dd/MM/yyyy"
									fieldGroupIds="fgDate"
									 change="onChangeDate" />
						</t:template>
					</t:Column>
					<t:Column
						autoResizable="true"
						filterProperty = "DateHigh"
						sortProperty = "DateHigh"
						width="9rem">
						<Label text="{i18n>hasta}"  required="true"/>
