                        aColumns.push({ label: sLabel, property: sProperty, type: sap.ui.export.EdmType.String });
                    }
                });

                if (!aColumns.length) {
                    sap.m.MessageToast.show("No hay columnas para exportar");
                    return;
                }

                var aFormattedData = aData.map(function (oItem) {
                    var oRow = {};
                    aColumns.forEach(function (oCol) {
                        var vValue = oItem[oCol.property];

                        if (oCol.property === "ExecutionHour") {
                            if (vValue && typeof vValue === "object" && vValue.ms !== undefined) {
                                var totalSeconds = Math.floor(vValue.ms / 1000);
                                var h = Math.floor(totalSeconds / 3600);
                                var m = Math.floor((totalSeconds % 3600) / 60);
                                var s = totalSeconds % 60;
                                vValue = h.toString().padStart(2, "0") + ":" +
                                    m.toString().padStart(2, "0") + ":" +
                                    s.toString().padStart(2, "0");
                            }
                        }

                        if (vValue === null || vValue === undefined) {
                            vValue = "";
                        }

                        oRow[oCol.property] = vValue;
                    });
                    return oRow;
                });

                var oSettings = {
                    workbook: { columns: aColumns },
                    dataSource: aFormattedData,
                    fileName: this.oResourceBundle.getText("nombreExcelMarkup") + ".xlsx",
                    worker: false
                };

                var oSheet = new sap.ui.export.Spreadsheet(oSettings);
                oSheet.build().finally(function () {
                    oSheet.destroy();
                });
            },
            oFileUploadMarkup: function (oEvent) {
                var oFile = oEvent.getParameter("files")[0];
                if (!oFile) return;
                //Funcion base para leer archivo
                var reader = new FileReader();
                reader.onload = function (e) {
                    var data = new Uint8Array(e.target.result);
                    var workbook = XLSX.read(data, { type: "array" });
                    var sheet = workbook.Sheets[workbook.SheetNames[0]];
                    var rows = XLSX.utils.sheet_to_json(sheet, { header: 1 }).slice(1);
                    var aData = [];
                    //Se crea variable para obtener el modelo 
                    var oModel = this.getView().getModel("mapfresa");
                    // Se comrpueba si existe y si no es nuevo
                    for (var i = 0; i < rows.length; i++) {
                        //Se obiente la propriedad 
                        var markup = oModel.getProperty("/markup");
                        //Creando variable para obtener la propriedad
                        var item = markup[i];
                        var row = rows[i];
                        //si la fila no está vacia, procesa
                        if (row.length !== 0) {
                            //Comprovar si el elemento existe en el modelo 
                            if (item) {
                                //si no existe Id se asigna el valor de ClassId
                                if (!item.Id) {

                                    item.Markup = row[0].toString() || "";
                                }
                                //Le pasamos la función para el formato correcto de las fechas para Javascript desde Excel
                                item.DateLow = this.excelDateToJSDate(row[1]) || null;
                                item.DateHigh = this.excelDateToJSDate(row[2]) || null;
                            } else {
                                //Si no existe se crea entrada para el oData
                                var oContextNat = this.getView().getModel().createEntry("/ZCMSD_FACT_FEES", {
                                    properties: {
                                        Zsociedad: '0004'
                                    }
                                })
                                //se crea objecto local con el path contexto del oData
                                item = {
                                    _pathSmarfield: oContextNat.getPath()
                                };
                                debugger;
                                //Se asignan los datos desde Excel
                                item.Markup = row[0] ? row[0].toString() : "";
                                item.DateLow = this.excelDateToJSDate(row[1]) || null;
                                item.DateHigh = this.excelDateToJSDate(row[2]) || null;
                                // Se agrega el nuevo elemento en el array
                                markup.push(item);
                                item._numerico = markup.length;
                            }
                        }
                    }
                    //Las propriedades se asignan en el modelo
                    oModel.setProperty("/markup", markup);
                    //Se actualiza el modelo
                    oModel.refresh(true);
                    //Se muestra un mensaje de carga correcta de los datos
                    sap.m.MessageToast.show("Excel cargado correctamente");
                    //Se bindea para reflejar datos en tabla
                }.bind(this);

                reader.readAsArrayBuffer(oFile);

            }
             // FIN RJVS 13/04/2026 Dowload y Upload datos excel
        });
    });
