//Creando una condición para obtener las fechas con el formato correcto 
excelDateToJSDate: function (serial) {
    //Si viene vacio o no es numero, se devuelve null
    if (serial === null || serial === undefined || serial === "" || isNaN(serial)) {
        return null;
    }
    var utc_days = Math.floor(serial - 25569);
    var utc_value = utc_days * 86400;
    var date_info = new Date(utc_value * 1000);

    var fecha = new Date(
        date_info.getUTCFullYear(),
        date_info.getUTCMonth(),
        date_info.getUTCDate()
    );
    //Se compensa la zona horaria igual que hace onChangeDate
    return new Date(fecha.getTime() - (fecha.getTimezoneOffset() * 60 * 1000));
},
// INI RJVS 09/03/2026 Dowload datos excel tableCeco
onDowloadExcelCeco: function () {
    var oTable = this.byId("tableCeco");
    // Se obtiene el binding de sus filas
    var oBinding = oTable.getBinding("rows");
    // Se obtiene los contexto de cada fila (todas, no solo las cargadas)
    var aContexts = oBinding.getContexts(0, oBinding.getLength());
    //Se comprueba si tamaño del array de contextos es distinto a 0
    if (!aContexts.length) {
        sap.m.MessageToast.show("No hay datos para exportar");
        return;
    }
    //Recorriendo los contextos para obtener los datos
    var aData = aContexts.map(function (oContext) {
        return oContext.getObject();
    });
    // Array de columnas
    var aColumns = [];
    // Recorremos las columnas
    oTable.getColumns().forEach(function (oColumn) {
        //Se obtiene el label
        var oLabel = oColumn.getLabel();
        // En caso que exista el label, se trae su texto, si no vacío
        var sLabel = oLabel ? oLabel.getText() : "";
        //Como se agrega el valor por sort o filter, identificamos la propiedad
        var sProperty = oColumn.getSortProperty() || oColumn.getFilterProperty() || "";
        //Se hace un if para setear 
        if (!sProperty) {
            return;
        }
        //if para determinar si el tipo es Date o String
        if (sProperty === "DateHigh" || sProperty === "DateLow" || sProperty === "ExecutionDate") {
            aColumns.push({
                label: sLabel,
                property: sProperty,
                type: sap.ui.export.EdmType.Date
            });
        } else {
            aColumns.push({
                label: sLabel,
                property: sProperty,
                type: sap.ui.export.EdmType.String
            });
        }
    });
    //Se anade la columna Id al principio para identificar las filas al cargar
    aColumns.unshift({
        label: "Id",
        property: "Id",
        type: sap.ui.export.EdmType.String
    });
    //Recorriendo los contextos para obtener los datos
    var aFormattedData = aData.map(function (oItem) {
        // Array de columna
        var oRow = {};
        // Recorremos las columnas
        aColumns.forEach(function (oCol) {
            //Creando variable para llegar a ExecutionHourdesde array
            var vValue = oItem[oCol.property];
            //Buscar la columna que apunta a ExecutionHour
            if (oCol.property === "ExecutionHour") {
                //Creando condición para comprobar si hay un objecto o si es indefinido
                if (vValue && typeof vValue === "object" && vValue.ms !== undefined) {

                    var totalSeconds = Math.floor(vValue.ms / 1000);
                    //caluclo para obtener horas, minutos y segundos
                    var h = Math.floor(totalSeconds / 3600);
                    var m = Math.floor((totalSeconds % 3600) / 60);
                    var s = totalSeconds % 60;

                    vValue =
                        h.toString().padStart(2, "0") + ":" +
                        m.toString().padStart(2, "0") + ":" +
                        s.toString().padStart(2, "0");
                }
            }
            // si es vacio me devuelve el campo vacio 
            if (vValue === null || vValue === undefined) {
                vValue = "";
            }

            oRow[oCol.property] = vValue;
        });

        return oRow;

    });
    // Se crea la configuracion del excel
    var oSettings = {
        workbook: {
            columns: aColumns
        },
        dataSource: aFormattedData,
        fileName: this.oResourceBundle.getText("nombreExcelCeco") + ".xlsx",
        worker: false
    };
    //Se genera un excel
    var oSheet = new sap.ui.export.Spreadsheet(oSettings);
    //Se descarga el excel
    oSheet.build().finally(function () {
        oSheet.destroy();
    });

},
oFileUploadCeco: function (oEvent) {
    //Se lee el fichero
    var oUploader = oEvent.getSource();
    var oFile = oEvent.getParameter("files")[0];
    if (!oFile) return;
    //Funcion base para leer archivo
    var reader = new FileReader();
    reader.onload = function (e) {
        var data = new Uint8Array(e.target.result);
        var workbook = XLSX.read(data, { type: "array" });
        var sheet = workbook.Sheets[workbook.SheetNames[0]];
        var rows = XLSX.utils.sheet_to_json(sheet, { header: 1 }).slice(1);
        //Se crea variable para obtener el modelo 
        var oModel = this.getView().getModel("mapfresa");
        var ceco = oModel.getProperty("/ceco");
        var aDeleteCeco = oModel.getProperty("/_deleteCeco");
        var tipoCeco = oModel.getProperty("/tipoCeco");

        for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            //si la fila esta vacia, se salta
            if (!row || row.length === 0) continue;

            //Se leen los datos de la fila
            var sId = row[0] ? row[0].toString().trim() : "";
            var sCostCenter = row[1] ? row[1].toString().trim() : "";
            var sDedication = row[2] ? row[2].toString().replace("%", "").replace(",", ".").trim() : "";
            var sTypeId = row[3] ? row[3].toString().trim() : "";
            var dDateLow = this.excelDateToJSDate(row[4]);
            var dDateHigh = this.excelDateToJSDate(row[5]);
            var item = null;

            if (sId) {
                //La fila ya existe: se busca por Id
                for (var j = 0; j < ceco.length; j++) {
                    if ((ceco[j].Id + "") === sId) {
                        item = ceco[j];
                        break;
                    }
                }
                //Si no esta en la tabla, se mira si se habia borrado y se recupera
                if (!item) {
                    for (var d = 0; d < aDeleteCeco.length; d++) {
                        if ((aDeleteCeco[d].Id + "") === sId) {
                            item = aDeleteCeco[d];
                            //Se saca de borradas y se devuelve a la tabla
                            aDeleteCeco.splice(d, 1);
                            ceco.push(item);
                            break;
                        }
                    }
                }
            }

            if (item) {
                //Fila existente o recuperada: solo se modifica lo editable.
                //CostCenter y TypeId no lo son cuando hay Id, no se tocan.
                item.Dedication = parseFloat(sDedication) || 0;
                item.DateLow = dDateLow;
                item.DateHigh = dDateHigh;
            } else {
                //Fila nueva: sin ceco no se puede dar de alta
                if (!sCostCenter) continue;
                //Si no existe se crea entrada para el oData
                var oContextCeco = this.getView().getModel().createEntry("/ZCMSD_FACT_CECO", {
                    properties: {
                        Zsociedad: '0004',
                        CostCenter: sCostCenter
                    }
                });
                //se crea objecto local con el path contexto del oData
                item = {
                    _pathSmarfield: oContextCeco.getPath(),
                    CostCenter: sCostCenter,
                    Dedication: parseFloat(sDedication) || 0,
                    TypeId: sTypeId,
                    DateLow: dDateLow,
                    DateHigh: dDateHigh
                };
                // Se agrega el nuevo elemento en el array
                ceco.push(item);

                //Se rellena Type y TypeOrder igual que hace onChangeTipo
                if (item.TypeId) {
                    for (var k = 0; k < tipoCeco.length; k++) {
                        if ((tipoCeco[k].Id + "") === (item.TypeId + "")) {
                            item.Type = this.aux.getProperty("/currentL") === 'es-ES'
                                ? tipoCeco[k].Description
                                : tipoCeco[k].DescriptionEng;
                            item.TypeOrder = tipoCeco[k].Orden;
                            break;
                        }
                    }
                }
            }
        }

        //Se renumera la columna del contador
        for (var n = 0; n < ceco.length; n++) {
            ceco[n]._numerico = n + 1;
        }

        //Las propriedades se asignan en el modelo
        oModel.setProperty("/ceco", ceco);
        //Se actualiza el modelo
        oModel.refresh(true);
        //Se limpia el uploader para poder subir el mismo fichero otra vez
        oUploader.clear();
        //Se muestra un mensaje de carga correcta de los datos
        sap.m.MessageToast.show("Excel cargado correctamente");
    }.bind(this);

    reader.readAsArrayBuffer(oFile);
},
