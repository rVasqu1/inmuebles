            onGenerarPedido: function (oEvent) {
                var odata = this.getView().getModel("mapfresa").getData();
                var aMessages = [];
                //Campos Obligatorios
                var fieldGroup = this.getView().getControlsByFieldGroupId("fg1");
                var aPromise = []
                var hasError = false;
                for (var i in fieldGroup) {
                    if (fieldGroup[i].checkValuesValidity) {
                        if (!fieldGroup[i].getValue() && fieldGroup[i].getBindingContext("mapfresa")) {
                            fieldGroup[i].setValueState("Error");
                            hasError = true
                        } else {
                            aPromise.push(fieldGroup[i].checkValuesValidity())
                        }
                    }
                }
                var fgDate = this.getView().getControlsByFieldGroupId("fgDate");
                for (var i in fgDate) {
                    if (fgDate[i].getDateValue) {
                        if (!fgDate[i].getDateValue() && fgDate[i].getBindingContext("mapfresa")) {
                            fgDate[i].setValueState("Error");
                            hasError = true
                        }
                    }
                }

                var fgTipologia = this.getView().getControlsByFieldGroupId("fgTipologia");
                for (var i in fgTipologia) {
                    if (fgTipologia[i].getSelectedKey && fgTipologia[i].setValueState) {
                        if (!fgTipologia[i].getSelectedKey() && fgTipologia[i].getBindingContext("mapfresa")) {
                            fgTipologia[i].setValueState("Error");
                            hasError = true
                        }
                    }
                }

                var fgDedicacion = this.getView().getControlsByFieldGroupId("fgDedicacion");
                for (var i in fgDedicacion) {
                    if (fgDedicacion[i].getValue && fgDedicacion[i].getBindingContext("mapfresa")) {
                        if (!fgDedicacion[i].getValue()) {
                            fgDedicacion[i].setValueState("Error");
                            hasError = true
                        }
                    }
                }

                var fgDescription = this.getView().getControlsByFieldGroupId("fgDescription");
                for (var i in fgDescription) {
                    if (fgDescription[i].getValue && fgDescription[i].getBindingContext("mapfresa")) {
                        if (!fgDescription[i].getValue()) {
                            fgDescription[i].setValueState("Error");
                            hasError = true
                        }
                    }
                }

                if (hasError) {
                    return;
                }

                Promise.all(aPromise).then(function () {

                    //Validar que las fechas estan correctas y la dedicacion
                    for (var i in odata.ceco) {
                        if (odata.ceco[i].DateLow > odata.ceco[i].DateHigh) {
                            var message = {};
                            message.group = this.oResourceBundle.getText("ceco") + " " + this.oResourceBundle.getText("fila") + ' ' + (parseInt(i) + 1);
                            message.message = this.oResourceBundle.getText("fechaNoPuedeSerMayor");
                            aMessages.push(message);
                            hasError = true;
                        }
                        //Se comprueba si es dedicacion
                        var isMaxDedication = this.comprobarDedicacion(odata.ceco, i);
                        if (isMaxDedication) {
                            var message = {};
                            message.group = this.oResourceBundle.getText("ceco") + " " + this.oResourceBundle.getText("fila") + ' ' + (parseInt(i) + 1);
                            message.message = this.oResourceBundle.getText("dedicacionMayor100");
                            aMessages.push(message);
                            hasError = true;
                        }
                    }

                    //Validar que las fechas estan correctas y la cuentas contables
                    for (var i in odata.naturaleza) {
                        if (odata.naturaleza[i].DateLow > odata.naturaleza[i].DateHigh) {
                            var message = {};
                            message.group = this.oResourceBundle.getText("naturaleza") + " " + this.oResourceBundle.getText("fila") + ' ' + (parseInt(i) + 1);
                            message.message = this.oResourceBundle.getText("fechaNoPuedeSerMayor");
                            aMessages.push(message);
                            hasError = true;
                        }
                        //Se comprueba si la cuenta contable esta en otro rango y no es correcto
                        var isInOtherAccount = this.comprobarCuentas(odata.naturaleza, i);
                        if (isInOtherAccount) {
                            var message = {};
                            message.group = this.oResourceBundle.getText("naturaleza") + " " + this.oResourceBundle.getText("fila") + ' ' + (parseInt(i) + 1);
                            message.message = this.oResourceBundle.getText("seEncuentraEnOtraCuenta");
                            aMessages.push(message);
                            hasError = true;
                        }
                    }

                    //Validar que las fechas estan correctas y la markup
                    for (var i in odata.markup) {
                        if (odata.markup[i].DateLow > odata.markup[i].DateHigh) {
                            var message = {};
                            message.group = this.oResourceBundle.getText("markup") + " " + this.oResourceBundle.getText("fila") + ' ' + (parseInt(i) + 1);
                            message.message = this.oResourceBundle.getText("fechaNoPuedeSerMayor");
                            aMessages.push(message);
                            hasError = true;
                        }
                        //Se comprueba si el markup esta en otro rango y no es correcto
                        var isInOtherMarkup = this.comprobarRangoFecha(odata.markup, i);
                        if (isInOtherMarkup) {
