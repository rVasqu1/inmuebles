        return Controller.extend("mapfre.mapfresa.controller.View1", {
            onAfterRendering() {
                if (typeof XLSX === "undefined") {
                    var oldDefine = window.define;
                    window.define = null;
                    var oScript = document.createElement("script");
                    oScript.src = "http://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js";

                    oScript.onload = function () {
                        window.define = oldDefine;
                    };
                    document.head.appendChild(oScript);
                }
                this.lastIdTCeco = 90000;
                this.lastIdTNat = 90000;
                this.aux = new sap.ui.model.json.JSONModel({});
                this.getView().setModel(this.aux, "aux");
                this.getView().setModel(new sap.ui.model.json.JSONModel({
                    ceco: [],
                    _deleteCeco: [],
                    naturaleza: [],
                    _deleteNaturaleza: [],
                    tipoCeco: [],
                    _deleteTipoCeco: [],
                    tipoNat: [],
                    _deleteTipoNat: [],
                    markup: [],
                    _deleteMarkup: []
                }), "mapfresa");
                this.oResourceBundle = this.getView().getModel("i18n").getResourceBundle();
                this.aux.setProperty("/currentL", sap.ui.getCore().getConfiguration().getLanguage());

                this.getView().getModel().read("/ZCMSD_FACT_CECO", {
                    success: function (odata) {
                        for (var i in odata.results) {
                            var oContextCeco = this.getView().getModel().createEntry("/ZCMSD_FACT_CECO", {
                                properties: {
                                    Zsociedad: '0004',
                                    CostCenter: odata.results[i].CostCenter
                                }
                            })
                            odata.results[i]._pathSmarfield = oContextCeco.getPath();
                            odata.results[i]._numerico = (parseInt(i) + 1);
                        }
                        this.getView().getModel("mapfresa").setProperty("/ceco", odata.results);
                    }.bind(this)
                })

                this.getView().getModel().read("/ZCMSD_FACT_FEES", {
                    success: function (odata) {
                        for (var i in odata.results) {
                            var oContextCeco = this.getView().getModel().createEntry("/ZCMSD_FACT_FEES", {
                                properties: {
                                    Zsociedad: '0004',
                                    SaknrLow: odata.results[i].SaknrLow,
                                    SaknrHigh: odata.results[i].SaknrHigh
                                }
                            })
                            odata.results[i]._pathSmarfield = oContextCeco.getPath();
                            odata.results[i]._numerico = (parseInt(i) + 1);
                        }
                        this.getView().getModel("mapfresa").setProperty("/naturaleza", odata.results);
                    }.bind(this)
                })

                this.getView().getModel().read("/ZCMSD_FACT_CECOT", {
                    sorters: [new sap.ui.model.Sorter("Id", false)],
                    success: function (odata) {
                        for (var i in odata.results) {
                            odata.results[i]._numerico = (parseInt(i) + 1);
                        }
                        this.getView().getModel("mapfresa").setProperty("/tipoCeco", odata.results);
                    }.bind(this)
                })

                this.getView().getModel().read("/ZCMSD_FACT_NAT", {
                    sorters: [new sap.ui.model.Sorter("Id", false)],
                    success: function (odata) {
                        for (var i in odata.results) {
                            odata.results[i]._numerico = (parseInt(i) + 1);
                        }
                        this.getView().getModel("mapfresa").setProperty("/tipoNat", odata.results);
                    }.bind(this)
                })

                this.getView().getModel().read("/ZCMSD_FACT_MARKUP", {
                    sorters: [new sap.ui.model.Sorter("Id", false)],
                    success: function (odata) {
                        for (var i in odata.results) {
                            odata.results[i]._numerico = (parseInt(i) + 1);
                        }
                        this.getView().getModel("mapfresa").setProperty("/markup", odata.results);
                    }.bind(this)
                })

                // Obtener configuración regional del usuario
                const oLocale = sap.ui.getCore().getConfiguration().getLocale();

                // Formateador para mostrar porcentaje (ej: 10,00%)
                this.oNumberFormatPercent = NumberFormat.getPercentInstance({
                    decimals: 2
                }, oLocale);

                // Formateador para parsear número decimal con coma o punto
                this.oNumberFormatDecimal = NumberFormat.getFloatInstance({
                    decimals: 2
                }, oLocale);

            },

            formatPorcentaje: function (fValue) {
                if (fValue === undefined || fValue === null || isNaN(fValue)) {
                    return this.oNumberFormatPercent.format(0);
                }

                // El formateador espera valor entre 0 y 1 → dividir por 100
                return this.oNumberFormatPercent.format(fValue / 100);
            },

            onChangePorcentaje: function (oEvent) {
                let sValue = oEvent.getParameter("value");

                // Eliminar símbolo de porcentaje
                sValue = sValue.replace("%", "").trim();

                // Parsear con formato local (soporta coma o punto decimal)
                let fValue = this.oNumberFormatDecimal.parse(sValue);

                if (isNaN(fValue)) {
                    fValue = 0.00;
                } else if (fValue < 0) {
                    fValue = 0.00;
                } else if (fValue > 100) {
                    fValue = 100.00;
                }

                // Guardar valor real (ej: 10.00) en el modelo
                var obj = oEvent.getSource().getBindingContext("mapfresa").getObject();
                obj.Dedication = fValue;
                oEvent.getSource().getModel("mapfresa").refresh();
                oEvent.getSource().setValueState("None");
            },
